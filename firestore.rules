rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'streakCount', 'points']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.streakCount is number && data.streakCount >= 0 &&
             data.points is number && data.points >= 0 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 32)) &&
             (!('dailyFuel' in data) || data.dailyFuel is number) &&
             (!('dailyGoal' in data) || data.dailyGoal is number) &&
             (!('completedQuestions' in data) || (data.completedQuestions is list && data.completedQuestions.size() <= 200)) &&
             (!('mockScores' in data) || (data.mockScores is list && data.mockScores.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Connection testing collection
    match /test/connection {
      allow read: if true;
    }

    // User profile and progress
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }
  }
}
